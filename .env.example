# Copy to .env.local (git-ignored) to give your build built-in organisations / a Google client.
# Built-in Microsoft 365 organisations: JSON list of { key, name, clientId, tenantId }.
# VITE_MS_TENANTS=[{"key":"org1","name":"My organisation","clientId":"00000000-0000-0000-0000-000000000000","tenantId":"00000000-0000-0000-0000-000000000000"}]
# Google OAuth client ID (web application).
# VITE_GOOGLE_CLIENT_ID=
